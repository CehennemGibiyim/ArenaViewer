# ATIKVIEWER ortam değişkenleri şablonu.
# Kullanım: cp .env.example .env  (ardından değerleri doldurun)
# Bu dosya güvenlidir (gerçek sır içermez) ve GitHub'a commit'lenir.

# Zorunlu: PostgreSQL bağlantısı (Drizzle ORM buradan okur)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Önerilen (üretimde zorunlu tutun): alan düzeyi AES-256-GCM şifreleme anahtarı (base64, 32 bayt).
# Üretim: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Boş bırakılırsa uygulama .data/enc.key dosyasını otomatik üretir (tek sunucu için yeterli).
DATA_ENCRYPTION_KEY=

# İsteğe bağlı: PACS (DICOMweb) kimlik başlığı, örn. "Basic dXNlcjpwYXNz"
PACS_AUTH_HEADER=

# İsteğe bağlı: HBYS/RIS istem alımı API anahtarı (/api/his/orders, x-api-key başlığı)
# Aynı anahtar, HL7 v2 (MLLP) köprüsünün de hedefidir: npm run hl7:mllp (bkz. README).
HIS_API_KEY=

# İsteğe bağlı: tek erişim anahtarı. Boş = kapı açık (demo); tanımlı = tüm sayfa/API
# istekleri /giris sayfasına düşer, doğru anahtar oturum çerezi yazar.
# Üret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN=

# İsteğe bağlı: kimlik modu.
#   boş/demo → erişim anahtarı varsa onunla; yoksa demo (tüm işlemler tek operatör).
#   hesap     → kullanıcı adı/parola (+MFA) zorunlu; ACCESS_TOKEN yalnız ek kapıdır.
# Hesap modunda ilk yönetici /giris sayfasındaki kurulum formuyla oluşturulur.
AUTH_MODE=

# Oturum çerezini imzalamak için gizli anahtar (hesap modunda zorunlu davranış sağlar).
# Tanımsızsa DATA_ENCRYPTION_KEY kullanılır; ikisi de yoksa hesap modunda oturum kurulamaz.
# Üret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# İki faktörlü doğrulamanın (TOTP/MFA) zorunlu olacağı roller (virgülle ayırın).
# Yönetici hesapları MFA kurmadan giremez. Boş = zorunluluk yok (yalnız elle açılabilir).
REQUIRE_TOTP_FOR_ROLES=yonetici

# İsteğe bağlı: taslak izlenim için OpenAI uyumlu LLM uç noktası (yoksa kural tabanlı yedek çalışır)
# Ücretsiz/yerel yol için Ollama kullanın: docs/OLLAMA.md
#   LLM_API_URL=http://127.0.0.1:11434/v1
#   LLM_API_KEY=ollama   (Ollama doğrulama istemez; boş kalmamalı)
#   LLM_MODEL=llama3.1:8b
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# İsteğe bağlı: yerel derin AI worker adresi (ai-worker/server.py; varsayılan http://127.0.0.1:8787).
# Derin tarama (BT toraks nodül adayı) bu süreç üzerinden çalışır; boş bırakılabilir.
AI_WORKER_URL=http://127.0.0.1:8787

# İsteğe bağlı: statik web derlemesi (GitHub Pages) — scripts/prepare-pages.sh bunu ayarlar.
# NEXT_PUBLIC_STATIC_DEMO=true

# İsteğe bağlı: GÖLGE MOD (henüz doğrulanmamış AI modelleri).
# true iken yapay zeka adayları rapora/ekrana girmez; yalnızca değerlendirme kaydı
# (/yonetim → AI performans ile izlenir) tutulur. Kapatıldığında bulgular yeniden
# "aday" etiketiyle rapora girer. Plan: docs/KLINIK_DOGRULAMA_PLANI.md §2.
NEXT_PUBLIC_AI_SHADOW_MODE=

# İsteğe bağlı: DENETİM → SIEM TESLİMATI (w-audit).
# Her denetim olayı önce veritabanı kuyruğuna yazılır; burada uç tanımlıysa
# HMAC-SHA256 imzalı JSON POST ile gönderilir (başlık: X-Atik-Signature).
# Gönderim başarısızsa üstel geri çekilmeyle yeniden denenir; olay kaybolmaz.
# Yönetim → Denetim kaydı ekranından kuyruk durumu izlenir / elle boşaltılır.
AUDIT_SIEM_URL=
AUDIT_SIEM_SECRET=
# Alternatif: UDP syslog (CEF satırı, ateşle-unut).
AUDIT_SYSLOG_HOST=
AUDIT_SYSLOG_PORT=514

# İsteğe bağlı: KURUMSAL GİRİŞ — OpenID Connect (docs/OIDC.md).
# OIDC_ISSUER ve OIDC_CLIENT_ID birlikte tanımlıysa /giris'te SSO düğmesi çıkar.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_ADMIN_GROUP=
OIDC_DEFAULT_ROLE=radyolog
OIDC_AUTO_PROVISION=1
OIDC_LINK_BY_EMAIL=1

# İsteğe bağlı: KURUMSAL GİRİŞ — LDAP / Active Directory (docs/LDAP.md).
# LDAP_URL + (LDAP_BASE_DN servis hesabıyla) ya da LDAP_USER_DN_TEMPLATE gerekir.
# Boş parola hiçbir zaman dizine gönderilmez (anonim bind koruması).
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# LDAP_USER_DN_TEMPLATE=uid={username},ou=people,dc=hastane,dc=local
LDAP_USER_FILTER=(|(sAMAccountName={username})(uid={username}))
LDAP_ATTR_NAME=cn
LDAP_ATTR_MAIL=mail
LDAP_ATTR_GROUPS=memberOf
LDAP_ADMIN_GROUP=
LDAP_DEFAULT_ROLE=radyolog
LDAP_AUTO_PROVISION=1
LDAP_TIMEOUT_MS=5000

# İsteğe bağlı: ÇERÇEVELEME (iframe) izinleri. Uygulama varsayılan olarak yalnız
# kendi kökeninde çerçevelenebilir (CSP frame-ancestors 'self' + X-Frame-Options).
# Kurumsal portalda ya da önizleme ortamında gömülecekse kökenleri yazın:
# AV_FRAME_ANCESTORS=https://portal.hastane.local https://*.e2b.app
AV_FRAME_ANCESTORS=

# İsteğe bağlı: KURUMSAL GİRİŞ — SAML 2.0 (docs/SAML.md).
# Üçü birlikte tanımlıysa /giris'te SAML düğmesi çıkar. Sertifika PEM ya da
# metadata'dan kopyalanan yalın base64 DER olabilir.
SAML_IDP_SSO_URL=
SAML_IDP_ENTITY_ID=
SAML_IDP_CERT=
SAML_ENTITY_ID=atikviewer-sp
SAML_ACS_URL=
SAML_LABEL=
SAML_ATTR_NAME=displayName
SAML_ATTR_MAIL=mail
SAML_ATTR_GROUPS=memberOf
SAML_NAME_ID_FORMAT=urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress
SAML_ADMIN_GROUP=
SAML_DEFAULT_ROLE=radyolog
SAML_AUTO_PROVISION=1
SAML_LINK_BY_EMAIL=0
SAML_SKIP_TOTP=1
SAML_CLOCK_SKEW_SEC=120
SAML_ALLOW_SHA1=0
